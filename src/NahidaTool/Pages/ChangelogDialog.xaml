<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NahidaTool.Pages.ChangelogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    Style="{StaticResource NahidaDialogStyle}"
    DefaultButton="Close"
    CloseButtonText="{x:Bind models:Lang.Changelog_Dismiss}">
    <ContentDialog.Title>
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top"
                    Background="{ThemeResource DialogCardBackgroundBrush}">
                <FontIcon Glyph="&#xE8A5;" FontSize="22"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="NahidaTool" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border Padding="8,2" CornerRadius="6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock x:Name="VersionBadge" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Bind models:Lang.Changelog_Title}"
                           AutomationProperties.HeadingLevel="Level1"
                           FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer x:Name="ContentViewport" Style="{StaticResource DialogScrollStyle}">
        <StackPanel Spacing="20">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind models:Lang.Changelog_Added}"
                           Style="{StaticResource DialogSectionStyle}"/>
                <Border Style="{StaticResource DialogCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE774;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="{x:Bind models:Lang.Changelog_StoryEndpointTitle}"
                                       Style="{StaticResource DialogItemTitleStyle}"/>
                            <TextBlock Text="{x:Bind models:Lang.Changelog_StoryEndpointDescription}"
                                       Style="{StaticResource DialogBodyStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DialogCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE118;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="{x:Bind models:Lang.Changelog_DownloadSizeTitle}"
                                       Style="{StaticResource DialogItemTitleStyle}"/>
                            <TextBlock Text="{x:Bind models:Lang.Changelog_DownloadSizeDescription}"
                                       Style="{StaticResource DialogBodyStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind models:Lang.Changelog_Improved}"
                           Style="{StaticResource DialogSectionStyle}"/>
                <Border Style="{StaticResource DialogCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{x:Bind models:Lang.Changelog_ClientDetectionTitle}"
                                           Style="{StaticResource DialogItemTitleStyle}"/>
                                <TextBlock Text="{x:Bind models:Lang.Changelog_ClientDetectionDescription}"
                                           Style="{StaticResource DialogBodyStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{x:Bind models:Lang.Changelog_TunProxyTitle}"
                                           Style="{StaticResource DialogItemTitleStyle}"/>
                                <TextBlock Text="{x:Bind models:Lang.Changelog_TunProxyDescription}"
                                           Style="{StaticResource DialogBodyStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8AB;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{x:Bind models:Lang.Changelog_VersionCheckTitle}"
                                           Style="{StaticResource DialogItemTitleStyle}"/>
                                <TextBlock Text="{x:Bind models:Lang.Changelog_VersionCheckDescription}"
                                           Style="{StaticResource DialogBodyStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{x:Bind models:Lang.Changelog_TransferFlowTitle}"
                                           Style="{StaticResource DialogItemTitleStyle}"/>
                                <TextBlock Text="{x:Bind models:Lang.Changelog_TransferFlowDescription}"
                                           Style="{StaticResource DialogBodyStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="HistorySection" Spacing="10">
                <Border Height="1" Margin="0,0,0,6" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <TextBlock Text="{x:Bind models:Lang.Changelog_History}" AutomationProperties.HeadingLevel="Level2"
                           Style="{StaticResource DialogSectionStyle}"/>
                <ItemsControl x:Name="HistoryList" ItemsSource="{x:Bind History}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChangelogHistoryEntry">
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="False" MinWidth="0" CornerRadius="12"
                                      AutomationProperties.Name="{x:Bind VersionLabel}">
                                <Expander.Resources>
                                    <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="DialogCardBackgroundBrush"/>
                                    <StaticResource x:Key="ExpanderContentBackground" ResourceKey="DialogCardBackgroundBrush"/>
                                    <Thickness x:Key="ExpanderHeaderPadding">16,12</Thickness>
                                    <Thickness x:Key="ExpanderContentPadding">16,14</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="12" ToolTipService.ToolTip="{x:Bind SourceLabel}">
                                        <TextBlock Text="{x:Bind VersionLabel}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Summary}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="·" Style="{StaticResource DialogBodyStyle}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                           Style="{StaticResource DialogBodyStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind models:Lang.Changelog_HistoryHint}"
                           Style="{StaticResource DialogBodyStyle}" FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
