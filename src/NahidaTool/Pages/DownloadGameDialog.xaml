<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NahidaTool.Pages.DownloadGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    Style="{StaticResource NahidaDialogStyle}"
    Title="{x:Bind models:Lang.DownloadDialog_Title}"
    PrimaryButtonText="{x:Bind models:Lang.DownloadDialog_StartInstall}"
    CloseButtonText="{x:Bind models:Lang.AppUpdate_Cancel}"
    PrimaryButtonClick="InstallButton_Click"
    IsPrimaryButtonEnabled="False"
    DefaultButton="Close">
    <ScrollViewer x:Name="ContentViewport" Style="{StaticResource DialogScrollStyle}">
        <StackPanel Spacing="20">
            <!-- 路径完整保留，显示截断时可通过提示查看。 -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource DialogCardStyle}" Padding="12,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="DownloadPathText" Grid.Column="1"
                                   VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Text, ElementName=DownloadPathText}"/>
                    </Grid>
                </Border>
                <Button x:Name="ChangeButton" Grid.Column="1" Padding="16,8"
                        VerticalAlignment="Center" CornerRadius="8"
                        Click="BrowseButton_Click" Content="{x:Bind models:Lang.DownloadDialog_Change}"/>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_ServerRegion}"
                               Style="{StaticResource DialogItemTitleStyle}"/>
                    <ComboBox x:Name="RegionComboBox" HorizontalAlignment="Stretch" MinWidth="0"
                              AutomationProperties.Name="{x:Bind models:Lang.DownloadSettingPage_ServerRegion}"
                              SelectionChanged="RegionComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_CN}" Tag="CN"/>
                        <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_OS}" Tag="OS"/>
                    </ComboBox>
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_ServerRegionHint}"
                               Style="{StaticResource DialogBodyStyle}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{x:Bind models:Lang.DownloadDialog_Version}"
                               Style="{StaticResource DialogItemTitleStyle}"/>
                    <TextBox x:Name="GameVersionTextBox" PlaceholderText="0.0.0" MinWidth="0"
                             AutomationProperties.Name="{x:Bind models:Lang.DownloadDialog_Version}"
                             TextChanged="GameVersionTextBox_TextChanged"/>
                    <TextBlock x:Name="VersionHintText" Text="{x:Bind models:Lang.DownloadDialog_VersionHint}"
                               Style="{StaticResource DialogBodyStyle}" FontSize="12"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource DialogCardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind models:Lang.DownloadDialog_GameResource}"
                                   Style="{StaticResource DialogItemTitleStyle}"/>
                        <TextBlock x:Name="GameSizeText" Grid.Column="1" Text="--" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind models:Lang.DownloadDialog_VoiceResource}"
                                   Style="{StaticResource DialogItemTitleStyle}"/>
                        <TextBlock x:Name="VoiceSizeText" Grid.Column="1" Text="--" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ChineseCheckBox" Grid.Row="0" Grid.Column="0" MinWidth="0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Checked="VoiceCheckBox_Changed" Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_VoiceChinese}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ChineseSizeText" Text="--" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="EnglishCheckBox" Grid.Row="0" Grid.Column="1" MinWidth="0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Checked="VoiceCheckBox_Changed" Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_VoiceEnglish}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="EnglishSizeText" Text="--" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="JapaneseCheckBox" Grid.Row="1" Grid.Column="0" MinWidth="0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Checked="VoiceCheckBox_Changed" Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_VoiceJapanese}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="JapaneseSizeText" Text="--" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="KoreanCheckBox" Grid.Row="1" Grid.Column="1" MinWidth="0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Checked="VoiceCheckBox_Changed" Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_VoiceKorean}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="KoreanSizeText" Text="--" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Spacing="6">
                <TextBlock x:Name="SummarySizeText" Style="{StaticResource DialogBodyStyle}" FontSize="12"/>
                <TextBlock x:Name="ValidationText" Style="{StaticResource DialogBodyStyle}" FontSize="12"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind models:Lang.DownloadDialog_AlreadyInstalled}"
                           Style="{StaticResource DialogBodyStyle}" FontSize="12"/>
                <HyperlinkButton Padding="0,4" HorizontalAlignment="Left"
                                 Content="{x:Bind models:Lang.DownloadDialog_LocateGame}"
                                 Click="LocateGameButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
