<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NahidaTool.Pages.DownloadGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="using:NahidaTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Background="{ThemeResource CustomAcrylicBrush}"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="12"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">520</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush"/>
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush"/>
    </ContentDialog.Resources>

    <Grid Width="600"
          Height="520"
          Padding="24,20,24,20"
          Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部：标题 + 关闭 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#F2F2F2"
                       Text="{x:Bind models:Lang.DownloadDialog_Title}"/>
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="CloseButton_Click"
                    CornerRadius="8">
                <FontIcon FontSize="12"
                          Glyph="&#xE711;"
                          Foreground="#A5ABB3"/>
            </Button>
        </Grid>

        <!-- ===== 路径输入区 ===== -->
        <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Height="40"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Background="#1F1C1F25"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock x:Name="DownloadPathText"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#F2F2F2"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button x:Name="ChangeButton"
                    Grid.Column="1"
                    Height="36"
                    Padding="20,0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Click="BrowseButton_Click"
                    CornerRadius="8">
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{x:Bind models:Lang.DownloadDialog_Change}"/>
            </Button>
        </Grid>

        <!-- ===== 服区选择 ===== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_ServerRegion}"
                           FontSize="13"
                           Foreground="#F2F2F2"/>
                <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_ServerRegionHint}"
                           FontSize="12"
                           Foreground="#7E848C"/>
            </StackPanel>
            <ComboBox x:Name="RegionComboBox"
                      Grid.Column="1"
                      Width="160"
                      Height="40"
                      Padding="12,8"
                      VerticalContentAlignment="Center"
                      Background="#1F1C1F25"
                      BorderBrush="#1AFFFFFF"
                      CornerRadius="8"
                      FontSize="13"
                      Foreground="#F2F2F2"
                      SelectionChanged="RegionComboBox_SelectionChanged">
                <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_CN}" Tag="CN"/>
                <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_OS}" Tag="OS"/>
            </ComboBox>
        </Grid>

        <!-- ===== 版本输入 ===== -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind models:Lang.DownloadDialog_Version}"
                           FontSize="13"
                           Foreground="#F2F2F2"/>
                <TextBlock x:Name="VersionHintText"
                           Text="{x:Bind models:Lang.DownloadDialog_VersionHint}"
                           FontSize="12"
                           Foreground="#7E848C"/>
            </StackPanel>
            <TextBox x:Name="GameVersionTextBox"
                     Grid.Column="1"
                     Width="160"
                     Height="40"
                     Padding="12,8"
                     VerticalContentAlignment="Center"
                     Background="#1F1C1F25"
                     BorderBrush="#1AFFFFFF"
                     CornerRadius="8"
                     FontSize="13"
                     Foreground="#F2F2F2"
                     PlaceholderText="0.0.0"
                     TextChanged="GameVersionTextBox_TextChanged"/>
        </Grid>

        <!-- ===== 资源选择卡片 ===== -->
        <Border Grid.Row="4"
                Margin="0,16,0,12"
                Padding="16,14"
                Background="#8C282C32"
                BorderBrush="#1AFFFFFF"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 游戏资源 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="14"
                              Foreground="#A5ABB3"
                              Glyph="&#xE8B7;"/>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#F2F2F2"
                               Text="{x:Bind models:Lang.DownloadDialog_GameResource}"/>
                    <TextBlock x:Name="GameSizeText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#A5ABB3"
                               Text="--"/>
                </Grid>

                <!-- 语音资源 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="14"
                              Foreground="#A5ABB3"
                              Glyph="&#xE8B7;"/>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#F2F2F2"
                               Text="{x:Bind models:Lang.DownloadDialog_VoiceResource}"/>
                    <TextBlock x:Name="VoiceSizeText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#A5ABB3"
                               Text="--"/>
                </Grid>

                <!-- 语言多选 2列 -->
                <Grid Grid.Row="2" Margin="0,12,0,0" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <CheckBox x:Name="ChineseCheckBox"
                                  Checked="VoiceCheckBox_Changed"
                                  Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="13" Foreground="#F2F2F2" Text="汉语"/>
                                <TextBlock x:Name="ChineseSizeText" FontSize="12" Foreground="#7E848C" Text="--"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="JapaneseCheckBox"
                                  Checked="VoiceCheckBox_Changed"
                                  Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="13" Foreground="#F2F2F2" Text="日语"/>
                                <TextBlock x:Name="JapaneseSizeText" FontSize="12" Foreground="#7E848C" Text="--"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <CheckBox x:Name="EnglishCheckBox"
                                  Checked="VoiceCheckBox_Changed"
                                  Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="13" Foreground="#F2F2F2" Text="英语"/>
                                <TextBlock x:Name="EnglishSizeText" FontSize="12" Foreground="#7E848C" Text="--"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="KoreanCheckBox"
                                  Checked="VoiceCheckBox_Changed"
                                  Unchecked="VoiceCheckBox_Changed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="13" Foreground="#F2F2F2" Text="韩语"/>
                                <TextBlock x:Name="KoreanSizeText" FontSize="12" Foreground="#7E848C" Text="--"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- 容量信息（贴在资源卡片外底部） -->
        <StackPanel Grid.Row="5"
                    Margin="2,8,0,0"
                    Spacing="4">
            <TextBlock x:Name="SummarySizeText"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       Foreground="#7E848C"
                       Text=""/>
            <TextBlock x:Name="ValidationText"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       Foreground="#FF8A8A"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ===== 底部操作区 ===== -->
        <StackPanel Grid.Row="6"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="14">
            <!-- 已安装？定位游戏（贴近开始安装按钮） -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="6">
                <TextBlock FontSize="13"
                           Foreground="#7E848C"
                           Text="{x:Bind models:Lang.DownloadDialog_AlreadyInstalled}"/>
                <Button Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="LocateGameButton_Click">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F2F2F2"
                               Text="{x:Bind models:Lang.DownloadDialog_LocateGame}"/>
                </Button>
            </StackPanel>
            <Button x:Name="StartInstallButton"
                    Height="36"
                    Padding="24,0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Click="StartInstallButton_Click"
                    CornerRadius="8">
                <TextBlock FontSize="13"
                           FontWeight="Bold"
                           Text="{x:Bind models:Lang.DownloadDialog_StartInstall}"/>
            </Button>
        </StackPanel>

    </Grid>
</ContentDialog>
