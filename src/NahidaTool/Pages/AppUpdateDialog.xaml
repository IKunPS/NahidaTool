<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NahidaTool.Pages.AppUpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NahidaTool.Models"
    Title="{x:Bind models:Lang.AppUpdate_Title}"
    PrimaryButtonText="{x:Bind models:Lang.AppUpdate_DownloadRestart}"
    CloseButtonText="{x:Bind models:Lang.AppUpdate_Later}"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Closing="ContentDialog_Closing">

    <Grid Width="520" MinHeight="260" Padding="0,8,0,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="VersionText" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="PublishedText" Grid.Row="1"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ScrollViewer Grid.Row="2" MaxHeight="260">
            <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        </ScrollViewer>
        <ProgressBar x:Name="UpdateProgressBar" Grid.Row="3" Height="4"
                     Maximum="100" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Grid.Row="4"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</ContentDialog>
