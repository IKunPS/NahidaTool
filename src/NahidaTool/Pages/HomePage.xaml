<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NahidaTool.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="using:NahidaTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NahidaTool.Models"
    xmlns:muxca="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Adapted from Starward StartGameButton (MIT, copyright 2023 Scighost). -->
    <Page.Resources>
        <Style x:Key="GameButtonStyle"
               BasedOn="{StaticResource DefaultButtonStyle}"
               TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AnimatedIcon.State="Normal"
                                          AutomationProperties.AccessibilityView="Raw"
                                          Background="{TemplateBinding Background}"
                                          BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.083"/>
                            </ContentPresenter.BackgroundTransition>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBackgroundPointerOver}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBorderBrushPointerOver}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.(AnimatedIcon.State)" Value="PointerOver"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBackgroundPressed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBorderBrushPressed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.(AnimatedIcon.State)" Value="Pressed"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBorderBrushDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.(AnimatedIcon.State)" Value="Normal"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          Background="Transparent">

        <Border x:Name="ProxyCard"
                Width="360"
                Margin="60,0,0,40"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource CustomAcrylicBrush}"
                CornerRadius="8"
                Shadow="{ThemeResource ThemeShadow}"
                Translation="0,0,16"
                Visibility="Collapsed">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Padding="16,12,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Glyph="&#xE774;"/>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind models:Lang.HomePage_Proxy}"/>
                    <TextBlock x:Name="ProxyStatusText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind models:Lang.HomePage_ProxyNotStarted}"/>
                </Grid>

                <StackPanel Grid.Row="1"
                            Padding="16,0,16,12"
                            Spacing="6">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind models:Lang.HomePage_ProxyAddress}"/>
                    <TextBox x:Name="ProxyAddressTextBox"
                             Height="32"
                             IsSpellCheckEnabled="False"
                             PlaceholderText="https://127.0.0.1:8080"
                             TextChanged="ProxyAddressTextBox_TextChanged"
                             LostFocus="ProxyAddressTextBox_LostFocus"
                             TextWrapping="NoWrap"/>
                    <TextBlock x:Name="ProxyErrorText"
                               FontSize="11"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind models:Lang.HomePage_ProxyUrlError}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,0,40,40"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid x:Name="StartGameGrid"
                      Height="44"
                      MinWidth="180"
                      Background="{ThemeResource CustomAcrylicBrush}"
                      CornerRadius="22"
                      PointerEntered="StartGameGrid_PointerEntered"
                      PointerExited="StartGameGrid_PointerExited"
                      Shadow="{ThemeResource ThemeShadow}"
                      Translation="0,0,16">
                    <Rectangle x:Name="Rect_AccentBackground"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>

                    <Button x:Name="StartGameButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="StartGameButton_Click"
                            CornerRadius="22"
                            PointerEntered="StartGameButton_PointerEntered"
                            PointerExited="StartGameButton_PointerExited"
                            Style="{ThemeResource GameButtonStyle}">
                        <Grid>
                            <Grid x:Name="NormalActionGrid" Visibility="Visible">
                                <ProgressRing x:Name="GameActionProgressRing"
                                              Width="20"
                                              Height="20"
                                              Margin="14,0,0,0"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Visibility="Collapsed"/>
                                <TextBlock x:Name="StartGameButtonText"
                                           Margin="41,5,53,6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text=""/>
                            </Grid>

                            <Grid x:Name="DownloadActionGrid"
                                  Margin="0,0,48,0"
                                  ColumnSpacing="10"
                                  IsHitTestVisible="False"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="10,0,0,0" HorizontalAlignment="Left">
                                    <ProgressRing x:Name="DownloadProgressRing"
                                                  Width="28"
                                                  Height="28"
                                                  Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                                                  IsIndeterminate="False"
                                                  Minimum="0"
                                                  Maximum="100"
                                                  Value="0"/>
                                    <TextBlock x:Name="DownloadPercentText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="0"/>
                                </Grid>

                                <Grid x:Name="DownloadStatePanel"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      ColumnSpacing="4"
                                      Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Row="0"
                                              Grid.Column="0"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE896;"
                                              IsTextScaleFactorEnabled="False"/>
                                    <TextBlock x:Name="DownloadStateText"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text=""/>
                                    <FontIcon Grid.Row="1"
                                              Grid.Column="0"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE917;"
                                              IsTextScaleFactorEnabled="False"/>
                                    <TextBlock x:Name="DownloadEtaText"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextScaleFactorEnabled="False"
                                               Text="--:--:--"/>
                                </Grid>

                                <TextBlock x:Name="DownloadHoverActionText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Width="44"
                            Height="44"
                            Padding="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SettingsButton_Click"
                            CornerRadius="22"
                            PointerEntered="SettingsButton_PointerEntered"
                            PointerExited="SettingsButton_PointerExited"
                            Style="{ThemeResource GameButtonStyle}">
                        <AnimatedIcon x:Name="AnimatedIcon_Setting">
                            <AnimatedIcon.Source>
                                <muxca:AnimatedSettingsVisualSource/>
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE713;"/>
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </Grid>
            </Grid>

            <Popup x:Name="DownloadInfoTip"
                   DesiredPlacement="Top"
                   PlacementTarget="{Binding ElementName=StartGameGrid}"
                   VerticalOffset="-4">
                <Grid MinWidth="200"
                      MaxWidth="260"
                      Padding="20,12"
                      Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                      CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DownloadPopupStateText"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       IsTextScaleFactorEnabled="False"
                                       Text=""/>
                            <TextBlock x:Name="DownloadTipProgressText"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="0%"/>
                            <FontIcon Margin="8,0,0,0"
                                      VerticalAlignment="Bottom"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE917;"
                                      IsTextScaleFactorEnabled="False"/>
                            <TextBlock x:Name="DownloadPopupRemainTimeText"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="--:--:--"/>
                        </StackPanel>
                        <MenuFlyoutSeparator Margin="0,8,0,0"/>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE896;"
                                      IsTextScaleFactorEnabled="False"/>
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind models:Lang.SettingsPage_Download}"/>
                        </StackPanel>
                        <Grid Width="200" Margin="0,2,0,0">
                            <TextBlock x:Name="DownloadPopupBytesText"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text=""/>
                            <TextBlock x:Name="DownloadPopupSpeedText"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text=""/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Popup>

            <Popup x:Name="Popup_GameInfo"
                   DesiredPlacement="Top"
                   PlacementTarget="{Binding ElementName=StartGameGrid}"
                   VerticalOffset="-4">
                <Border MinWidth="200"
                        Padding="20,12,20,12"
                        Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                        CornerRadius="8">
                    <TextBlock x:Name="RunningInfoPopupText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text=""/>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Page>
