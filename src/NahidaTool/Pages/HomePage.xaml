<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NahidaTool.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="using:NahidaTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid x:Name="RootGrid"
          Background="Transparent">

        <!-- 代理卡片 -->
        <Border x:Name="ProxyCard"
                Width="360"
                Margin="60,0,0,40"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource CustomAcrylicBrush}"
                CornerRadius="8"
                Shadow="{ThemeResource ThemeShadow}"
                Translation="0,0,16"
                Visibility="Collapsed">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Header -->
                <Grid Padding="16,12,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="20"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Glyph="&#xE774;"/>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind models:Lang.HomePage_Proxy}"/>
                    <TextBlock x:Name="ProxyStatusText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind models:Lang.HomePage_ProxyNotStarted}"/>
                </Grid>

                <!-- Row 1: Proxy Settings -->
                <StackPanel Grid.Row="1"
                            Padding="16,0,16,12"
                            Spacing="6">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind models:Lang.HomePage_ProxyAddress}"/>
                    <TextBox x:Name="ProxyAddressTextBox"
                             Height="32"
                             IsSpellCheckEnabled="False"
                             PlaceholderText="https://127.0.0.1:8080"
                             TextChanged="ProxyAddressTextBox_TextChanged"
                             LostFocus="ProxyAddressTextBox_LostFocus"
                             TextWrapping="NoWrap"/>
                    <TextBlock x:Name="ProxyErrorText"
                               FontSize="11"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind models:Lang.HomePage_ProxyUrlError}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,0,40,40"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Download Section -->
            <Border x:Name="DownloadSection"
                    Grid.Row="0"
                    Width="340"
                    Margin="0,0,0,8"
                    Padding="16"
                    Background="{ThemeResource CustomAcrylicBrush}"
                    CornerRadius="8"
                    Shadow="{ThemeResource ThemeShadow}"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DownloadVersionText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="--"/>
                    <TextBlock x:Name="DownloadStatsText"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="--"/>
                    <TextBlock x:Name="DownloadPercentText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GenshinPrimaryBrush}"
                               Text="0%"
                               Visibility="Collapsed"/>
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Height="6"
                                 CornerRadius="3"
                                 Background="#25FFFFFF"
                                 Foreground="{StaticResource GenshinPrimaryBrush}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadSpeedText"
                                   Grid.Column="0"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="--"/>
                        <TextBlock x:Name="DownloadRemainingText"
                                   Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="--"/>
                    </Grid>
                    <Button x:Name="PauseResumeButton"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            Click="PauseResumeButton_Click"
                            CornerRadius="6"
                            FontSize="13"
                            Style="{StaticResource DateTimePickerFlyoutButtonStyle}">
                        <TextBlock x:Name="PauseResumeButtonText" Text="--"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Row 1: Button Row -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Download / Install Button -->
                <Button x:Name="InstallButton"
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        Padding="0"
                        Background="{ThemeResource CustomAcrylicBrush}"
                        BorderThickness="0"
                        CornerRadius="22"
                        Shadow="{ThemeResource ThemeShadow}"
                        Translation="0,0,16"
                        Click="InstallButton_Click"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="{x:Bind models:Lang.DownloadPage_StartDownload}">
                    <FontIcon Glyph="&#xE896;" FontSize="18"/>
                </Button>

                <!-- Start Game Grid -->
                <Grid x:Name="StartGameGrid"
                      Grid.Column="1"
                      Height="44"
                      MinWidth="180"
                      Background="{ThemeResource CustomAcrylicBrush}"
                      CornerRadius="22"
                      Shadow="{ThemeResource ThemeShadow}"
                      Translation="0,0,16"
                      PointerEntered="StartGameGrid_PointerEntered"
                      PointerExited="StartGameGrid_PointerExited">

                    <Rectangle x:Name="Rect_AccentBackground"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>

                    <Button x:Name="StartGameButton"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="22"
                            Click="StartGameButton_Click"
                            FontSize="15">
                        <TextBlock x:Name="StartGameButtonText"
                                   Margin="41,5,53,6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind models:Lang.HomePage_StartGame}"/>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Width="44"
                            Height="44"
                            Padding="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="22"
                            Click="SettingsButton_Click">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="18"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- Game Info Popup -->
            <Popup x:Name="Popup_GameInfo"
                   DesiredPlacement="Top"
                   PlacementTarget="{Binding ElementName=StartGameGrid}"
                   VerticalOffset="-4">
                <Border MinWidth="200"
                        Padding="20,12,20,12"
                        Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                        CornerRadius="8">
                    <TextBlock x:Name="RunningInfoPopupText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text=""/>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Page>