<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NahidaTool.Pages.Controls.BackgroundImagePositionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay">
    <StackPanel Spacing="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                       Text="{x:Bind models:Lang.HomeSettingDialog_ImagePosition}"/>
            <Button x:Name="CenterButton" Grid.Column="1" Padding="10,4"
                    Click="CenterButton_Click"
                    Content="{x:Bind models:Lang.HomeSettingDialog_ImagePositionCenter}"/>
        </Grid>
        <Border Height="140" Padding="4" CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False"/>
                <ProgressRing x:Name="PreviewProgress" Width="24" Height="24"
                              AutomationProperties.Name="{x:Bind models:Lang.HomeSettingDialog_ImagePositionLoading}"
                              IsActive="False" Visibility="Collapsed"/>
                <StackPanel x:Name="PreviewState" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="PreviewStateText" FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="PreviewRetryButton" HorizontalAlignment="Center"
                            Click="PreviewRetryButton_Click" Visibility="Collapsed"
                            Content="{x:Bind models:Lang.HomeSettingDialog_ImagePositionRetry}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Text="{x:Bind models:Lang.HomeSettingDialog_ImagePositionHorizontal}"/>
            <TextBlock x:Name="HorizontalValueText" Grid.Column="1" FontSize="12"/>
        </Grid>
        <Slider x:Name="HorizontalSlider" Minimum="-100" Maximum="100" StepFrequency="1"
                AutomationProperties.Name="{x:Bind models:Lang.HomeSettingDialog_ImagePositionHorizontal}"
                ValueChanged="PositionSlider_ValueChanged" IsEnabled="False"/>
        <Grid>
            <TextBlock FontSize="11" Opacity="0.65" Text="{x:Bind models:Lang.HomeSettingDialog_ImagePositionLeft}"/>
            <TextBlock FontSize="11" Opacity="0.65" HorizontalAlignment="Right"
                       Text="{x:Bind models:Lang.HomeSettingDialog_ImagePositionRight}"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Text="{x:Bind models:Lang.HomeSettingDialog_ImagePositionVertical}"/>
            <TextBlock x:Name="VerticalValueText" Grid.Column="1" FontSize="12"/>
        </Grid>
        <Slider x:Name="VerticalSlider" Minimum="-100" Maximum="100" StepFrequency="1"
                AutomationProperties.Name="{x:Bind models:Lang.HomeSettingDialog_ImagePositionVertical}"
                ValueChanged="PositionSlider_ValueChanged" IsEnabled="False"/>
        <Grid>
            <TextBlock FontSize="11" Opacity="0.65" Text="{x:Bind models:Lang.HomeSettingDialog_ImagePositionUp}"/>
            <TextBlock FontSize="11" Opacity="0.65" HorizontalAlignment="Right"
                       Text="{x:Bind models:Lang.HomeSettingDialog_ImagePositionDown}"/>
        </Grid>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind models:Lang.HomeSettingDialog_ImagePositionHint}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
