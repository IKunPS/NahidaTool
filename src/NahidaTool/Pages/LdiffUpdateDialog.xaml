<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NahidaTool.Pages.LdiffUpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource CustomAcrylicBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CloseButtonText="{x:Bind models:Lang.Ldiff_Close}"
    Closing="ContentDialog_Closing"
    CornerRadius="12"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    Opened="ContentDialog_Opened"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="{x:Bind models:Lang.Ldiff_Start}"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="{x:Bind models:Lang.Ldiff_Title}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">480</x:Double>

        <Style x:Key="LdiffLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="LdiffValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="500"
          MinHeight="260"
          Padding="0,8,0,2"
          RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Current operation and state -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="40"
                    Height="40"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                <FontIcon FontSize="19"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          Glyph="&#xE896;"
                          IsTextScaleFactorEnabled="False"/>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       MaxLines="3"
                       Text="{x:Bind models:Lang.Ldiff_Checking}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="WrapWholeWords"/>
        </Grid>

        <!-- Version transition -->
        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource LdiffLabelStyle}"
                           Text="{x:Bind models:Lang.Ldiff_CurrentVersion}"/>
                <TextBlock x:Name="CurrentVersionText"
                           Style="{StaticResource LdiffValueStyle}"
                           Text="-"/>
            </StackPanel>

            <FontIcon Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="16"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Glyph="&#xE72A;"
                      IsTextScaleFactorEnabled="False"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource LdiffLabelStyle}"
                           Text="{x:Bind models:Lang.Ldiff_TargetVersion}"/>
                <TextBlock x:Name="TargetVersionText"
                           Style="{StaticResource LdiffValueStyle}"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                           Text="-"/>
            </StackPanel>

            <Rectangle Grid.Column="3"
                       Width="1"
                       Height="48"
                       VerticalAlignment="Center"
                       Fill="{ThemeResource TextFillColorSecondaryBrush}"
                       Opacity="0.16"/>

            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource LdiffLabelStyle}"
                           Text="{x:Bind models:Lang.Ldiff_DownloadSize}"/>
                <TextBlock x:Name="DownloadSizeText"
                           Style="{StaticResource LdiffValueStyle}"
                           FontSize="18"
                           Text="-"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="2"
                   Height="1"
                   HorizontalAlignment="Stretch"
                   Fill="{ThemeResource TextFillColorSecondaryBrush}"
                   Opacity="0.12"/>

        <!-- Progress information -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource LdiffLabelStyle}"
                       Text="{x:Bind models:Lang.Ldiff_Title}"/>
            <TextBlock x:Name="ProgressText"
                       Grid.Column="1"
                       Margin="16,0,0,0"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text=""
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <ProgressBar x:Name="UpdateProgressBar"
                     Grid.Row="4"
                     Height="6"
                     IsIndeterminate="True"
                     Maximum="100"/>
    </Grid>
</ContentDialog>
