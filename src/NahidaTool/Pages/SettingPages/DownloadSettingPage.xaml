<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NahidaTool.Pages.SettingPages.DownloadSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NahidaTool.Pages.SettingPages"
    xmlns:lang="using:NahidaTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="0,0,24,0">

            <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_Title}" FontSize="20" FontWeight="SemiBold"/>

            <!-- 下载目录 -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="14"
                       Opacity="0.85"
                       Text="{x:Bind models:Lang.DownloadSettingPage_DownloadDirectory}"/>
            <Grid Margin="0,8,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#12FFFFFF" CornerRadius="6"
                        BorderBrush="#25FFFFFF" BorderThickness="1" Padding="14,12">
                    <TextBlock x:Name="DownloadPathText" Text="文档\NahidaTool"
                               TextTrimming="CharacterEllipsis" Opacity="0.9" FontSize="13"/>
                </Border>

                <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click"
                        Padding="14,12">
                    <FontIcon Glyph="&#xE838;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- 游戏版本 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_GameVersion}" FontSize="14" FontWeight="Medium"/>
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_GameVersionHint}" FontSize="12" Opacity="0.7"/>
                </StackPanel>

                <TextBox x:Name="GameVersionTextBox" Grid.Column="1" Width="140"
                         PlaceholderText="0.0.0" CornerRadius="6"
                         Padding="14,12" FontSize="13"
                         TextChanged="GameVersionTextBox_TextChanged"/>
            </Grid>

            <!-- 服务器区域 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_ServerRegion}" FontSize="14" FontWeight="Medium"/>
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_ServerRegionHint}" FontSize="12" Opacity="0.7"/>
                </StackPanel>

                <ComboBox x:Name="RegionComboBox" Grid.Column="1" Width="140"
                          SelectionChanged="RegionComboBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_CN}" Tag="CN"/>
                    <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_OS}" Tag="OS"/>
                </ComboBox>
            </Grid>

            <!-- 语音包 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_VoiceLanguage}" FontSize="14" FontWeight="Medium"/>
                    <TextBlock Text="{x:Bind models:Lang.DownloadSettingPage_VoiceLanguageHint}" FontSize="12" Opacity="0.7"/>
                </StackPanel>

                <ComboBox x:Name="VoiceLanguageComboBox" Grid.Column="1" Width="140"
                          SelectionChanged="VoiceLanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_VoiceNone}" Tag="None"/>
                    <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_VoiceChinese}" Tag="Chinese"/>
                    <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_VoiceEnglish}" Tag="English"/>
                    <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_VoiceJapanese}" Tag="Japanese"/>
                    <ComboBoxItem Content="{x:Bind models:Lang.DownloadSettingPage_VoiceKorean}" Tag="Korean"/>
                </ComboBox>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</Page>