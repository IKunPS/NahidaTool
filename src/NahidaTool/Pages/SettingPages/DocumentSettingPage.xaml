<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NahidaTool.Pages.SettingPages.DocumentSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>

        <!-- 文档列表视图 -->
        <ScrollViewer x:Name="DocumentScrollViewer"
                      Padding="48,32,32,24">
            <StackPanel Spacing="24">

                <!-- 页面标题 -->
                <StackPanel Spacing="4" Margin="0,0,0,12">
                    <TextBlock FontSize="32"
                               FontWeight="SemiBold"
                               Text="{x:Bind models:Lang.HomeSettingDialog_Document}"/>
                    <TextBlock FontSize="14"
                               Opacity="0.8"
                               Text="{x:Bind models:Lang.DocumentSettingPage_Subtitle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="{x:Bind models:Lang.DocumentSettingPage_VideoHintTitle}"
                         Message="{x:Bind models:Lang.DocumentSettingPage_VideoHintMessage}"/>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Warning"
                         Title="{x:Bind models:Lang.DocumentSettingPage_PathWarningTitle}"
                         Message="{x:Bind models:Lang.DocumentSettingPage_PathWarningMessage}"/>

                <!-- 服务器游玩教程 -->
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{x:Bind models:Lang.DocumentSettingPage_HowToPlay}"/>

                    <!-- Step 1 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step1}"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step1Detail}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step RSA -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_StepRSA}"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_StepRSADetail}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step2}"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step2Detail}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step3}"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step3Detail}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 4 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step4}"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Step4Detail}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 错误码说明 -->
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{x:Bind models:Lang.DocumentSettingPage_ErrorCodes}"/>

                    <TextBlock FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind models:Lang.DocumentSettingPage_ErrorCodeHint}"
                               TextWrapping="Wrap"/>

                    <!-- 2, 0, 4 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="2, 0, 4"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Error204}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 4201 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="4201"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Error4201}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 4206 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="4206"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Error4206}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 4214 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="4214"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Error4214}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 4301 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="4301"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Error4301}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 4308 -->
                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="4308"/>
                            <TextBlock FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind models:Lang.DocumentSettingPage_Error4308}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 教程视频 -->
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{x:Bind models:Lang.DocumentSettingPage_TutorialVideos}"/>

                    <ItemsControl x:Name="VideoList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button MinHeight="56"
                                        Margin="0,4"
                                        Padding="16,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="0"
                                        Click="VideoCard_Click"
                                        CornerRadius="8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="36"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="18">
                                            <FontIcon FontSize="14"
                                                      Glyph="&#xE768;"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{x:Bind}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- 视频播放覆盖层 -->
        <Grid x:Name="VideoPlayerOverlay"
              Background="#FF000000"
              Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition/>
            </Grid.OpacityTransition>

            <!-- 全屏播放器 -->
            <MediaPlayerElement x:Name="VideoPlayer"
                                AreTransportControlsEnabled="True"
                                AutoPlay="True"
                                Stretch="UniformToFill"/>

            <!-- 顶部浮动返回按钮 -->
            <Button Margin="16,12,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#40000000"
                    BorderThickness="0"
                    Click="BackFromVideo_Click"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72B;"/>
                    <TextBlock x:Name="VideoTitleText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </Grid>

    </Grid>
</Page>
