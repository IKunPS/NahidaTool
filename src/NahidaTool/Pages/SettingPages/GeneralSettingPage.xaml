<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NahidaTool.Pages.SettingPages.GeneralSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="using:NahidaTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="0,0,24,0">

            <!-- 语言 -->
            <TextBlock FontSize="20" Text="{x:Bind models:Lang.GeneralSettingPage_Language}"/>
            <ComboBox x:Name="ComboBox_Language"
                      Height="36"
                      MinWidth="260"
                      Margin="0,12,0,0"
                      Padding="18.5,0,0,0"
                      BorderThickness="0"
                      CornerRadius="8,18,18,8"
                      SelectionChanged="ComboBox_Language_SelectionChanged"/>

            <!-- 关闭窗口行为 -->
            <TextBlock Margin="0,32,0,0"
                       FontSize="20"
                       Text="{x:Bind models:Lang.GeneralSettingPage_CloseWindowBehavior}"/>
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="24">
                <RadioButton x:Name="RadioButton_CloseWindowOption_Hide"
                             Checked="RadioButton_CloseWindowOption_Checked"
                             Content="{x:Bind models:Lang.GeneralSettingPage_MinimizeToSystemTray}"
                             GroupName="CloseWindowOption"
                             Tag="Hide"/>
                <RadioButton x:Name="RadioButton_CloseWindowOption_Exit"
                             Checked="RadioButton_CloseWindowOption_Checked"
                             Content="{x:Bind models:Lang.GeneralSettingPage_ExitCompletely}"
                             GroupName="CloseWindowOption"
                             Tag="Exit"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>