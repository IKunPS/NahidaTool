<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NahidaTool.Pages.NoticeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NahidaTool.Models"
    Style="{StaticResource NahidaDialogStyle}"
    DefaultButton="Close">
    <ScrollViewer x:Name="ContentViewport" Style="{StaticResource DialogScrollStyle}">
        <Border Style="{StaticResource DialogCardStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="MessageIcon" Glyph="&#xE946;" FontSize="20"
                          VerticalAlignment="Top" Margin="0,2,0,0"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="MessageText" Grid.Column="1" Style="{StaticResource DialogBodyStyle}"/>
            </Grid>
        </Border>
    </ScrollViewer>
</ContentDialog>
