<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NahidaTool.Pages.ServerSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lang="using:NahidaTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <!-- 页面标题 -->
            <StackPanel Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_Title}" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_Description}" FontSize="14" Opacity="0.8"/>
            </StackPanel>

            <!-- 当前服务器状态 -->
            <Border Background="#18FFFFFF" CornerRadius="8" Padding="20"
                    BorderBrush="#20FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_CurrentServer}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentServerText" Text="{x:Bind models:Lang.ServerSwitchPage_Detecting}"
                                   FontSize="16" FontWeight="Medium" Foreground="{StaticResource GenshinPrimaryBrush}"/>
                    </StackPanel>

                    <Button x:Name="DetectButton" Grid.Column="1" Click="DetectButton_Click"
                            Padding="8" Style="{StaticResource DateTimePickerFlyoutButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind models:Lang.ServerSwitchPage_ReDetect}">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 服务器切换 -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_SelectTargetServer}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 国服 -->
                    <Button x:Name="ChinaServerButton" Grid.Column="0"
                            Click="ChinaServerButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0" CornerRadius="8"
                            Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Border Padding="24,28" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="26"
                                        Background="#254CAF50">
                                    <FontIcon Glyph="&#xE80F;"
                                              FontSize="22" Foreground="#4CAF50"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_CN}" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_CN_Short}" FontSize="13" Opacity="0.7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 国际服 -->
                    <Button x:Name="GlobalServerButton" Grid.Column="1"
                            Click="GlobalServerButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0" CornerRadius="8"
                            Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Border Padding="24,28" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="26"
                                        Background="#2500BCD4">
                                    <FontIcon Glyph="&#xE909;"
                                              FontSize="22" Foreground="#00BCD4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_OS}" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_OS_Short}" FontSize="13" Opacity="0.7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 提示 -->
            <Border Background="#25FFC107" CornerRadius="6" Padding="16,14"
                    BorderBrush="#40FFC107" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE946;" FontSize="16"
                              Foreground="#FFC107" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_Warning}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 进度卡片 -->
            <Border x:Name="ProgressCard" Background="#18FFFFFF" CornerRadius="8"
                    Padding="24" Visibility="Collapsed" BorderBrush="#20FFFFFF" BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="{x:Bind models:Lang.ServerSwitchPage_Preparing}"
                                       FontSize="14" FontWeight="Medium"/>
                            <TextBlock x:Name="ProgressPercentText" Grid.Column="1"
                                       Text="0%" FontSize="14" FontWeight="Medium" Opacity="0.85"/>
                        </Grid>

                        <ProgressBar x:Name="SwitchProgressBar" Minimum="0" Maximum="100"
                                     Value="0" Height="6" CornerRadius="3"
                                     Foreground="{StaticResource GenshinPrimaryBrush}"/>
                    </StackPanel>

                    <!-- 日志 -->
                    <Border Background="#10000000" CornerRadius="6" Padding="14" Height="180"
                            BorderBrush="#15FFFFFF" BorderThickness="1">
                        <ScrollViewer x:Name="DetailScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailText" Text="" FontSize="12" Opacity="0.9"
                                       TextWrapping="Wrap" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>