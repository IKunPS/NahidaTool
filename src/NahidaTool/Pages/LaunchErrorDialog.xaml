<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NahidaTool.Pages.LaunchErrorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    CloseButtonText="{x:Bind models:Lang.HomePage_OK}"
    Style="{StaticResource NahidaDialogStyle}"
    Title="{x:Bind models:Lang.HomePage_LaunchFailed}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer x:Name="ContentViewport" Style="{StaticResource DialogScrollStyle}">
        <Grid Padding="0,8,0,2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" VerticalAlignment="Top"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10">
                <FontIcon FontSize="19"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          Glyph="&#xE7BA;"
                          IsTextScaleFactorEnabled="False"/>
            </Border>
            <Border Grid.Column="1" Padding="14,12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                <TextBlock x:Name="MessageText"
                           FontSize="14" LineHeight="22"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </ScrollViewer>
</ContentDialog>
