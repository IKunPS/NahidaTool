<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NahidaTool.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NahidaTool"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 参考 Starward 的方式：全局隐式 Style 直接引用字体文件 -->
            <FontFamily x:Key="SegoeFluentIcons">ms-appx:///Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons</FontFamily>
            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/SegoeIcons.ttf#Segoe Fluent Icons" />
            </Style>

            <!-- 水平渐变（主按钮背景） -->
            <LinearGradientBrush x:Key="GenshinGradientBrushHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#4CAF50" Offset="0"/>
                <GradientStop Color="#26A69A" Offset="0.5"/>
                <GradientStop Color="#00BCD4" Offset="1"/>
            </LinearGradientBrush>

            <!--  Shadow  -->
            <ThemeShadow x:Key="ThemeShadow" />

            <!-- 白色纯色画刷 -->
            <SolidColorBrush x:Key="GenshinPrimaryBrush" Color="White"/>

            <!-- NavigationView 侧边栏 -->
            <AcrylicBrush x:Key="CustomAcrylicBrush"
                          FallbackColor="#F52C2C2C"
                          TintColor="Black"
                          TintOpacity="0.35"/>
            <AcrylicBrush x:Key="CustomOverlayAcrylicBrush"
                          FallbackColor="#F52C2C2C"
                          TintColor="Black"
                          TintOpacity="0.4"/>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="CustomAcrylicBrush"/>
            <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>

            <!-- 主按钮：渐绿背景，白色文字 -->
            <Style x:Key="GenshinPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GenshinGradientBrushHorizontal}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 强调色按钮：背景跟随 AccentFillColorDefaultBrush，白色文字 -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
