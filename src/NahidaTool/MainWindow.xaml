<?xml version="1.0" encoding="utf-8"?>
<fw:WindowEx
    x:Class="NahidaTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:NahidaTool"
    xmlns:lang="using:NahidaTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fw="using:NahidaTool.Frameworks"
    xmlns:models="using:NahidaTool.Models"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d"
    Title="NahidaTool">

    <Grid>

        <!-- 双背景图片交叉淡入淡出（视频帧也通过此 Image 渲染） -->
        <Image x:Name="BackgroundImage1"
               Source="./Assets/Nahida.png"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               Opacity="1">
            <Image.OpacityTransition>
                <ScalarTransition/>
            </Image.OpacityTransition>
        </Image>
        <Image x:Name="BackgroundImage2"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               Opacity="0">
            <Image.OpacityTransition>
                <ScalarTransition/>
            </Image.OpacityTransition>
        </Image>

        <!-- 侧边栏底色 -->
        <Border Width="58" HorizontalAlignment="Left"
                IsHitTestVisible="False"
                Background="{ThemeResource CustomAcrylicBrush}"/>

        <!-- 叠加遮罩层：进入非主页时显示亚克力毛玻璃效果 -->
        <Border x:Name="Border_OverlayMask"
                Background="{ThemeResource CustomAcrylicBrush}"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition/>
            </Border.OpacityTransition>
        </Border>

        <NavigationView x:Name="MainNavView"
                        PaneDisplayMode="LeftCompact"
                        CompactPaneLength="58"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        ItemInvoked="MainNavView_ItemInvoked">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#33FFFFFF"/>
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Grid Width="58" Height="51">
                    <Border Width="38" Height="38"
                            CornerRadius="8"
                            Background="Transparent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,7,0,0">
                        <Image Source="./Assets/ic_launcher.ico"
                               Width="38" Height="38"
                               Stretch="Uniform"/>
                    </Border>
                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItemSeparator/>

                <!-- 主页 -->
                <NavigationViewItem x:Name="NavigationViewItem_Home"
                                    Tag="Home"
                                    IsSelected="True"
                                    ToolTipService.Placement="Right">
                    <ToolTipService.ToolTip>
                        <ToolTip HorizontalOffset="12">
                            <TextBlock Text="{x:Bind models:Lang.HomePage_Title}"/>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind models:Lang.HomePage_Title}"/>
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- 转服 -->
                <NavigationViewItem Tag="ServerSwitch"
                                    ToolTipService.Placement="Right">
                    <ToolTipService.ToolTip>
                        <ToolTip HorizontalOffset="12">
                            <TextBlock Text="{x:Bind models:Lang.ServerSwitchPage_Title}"/>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind models:Lang.ServerSwitchPage_Title}"/>
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- 文档 -->
                <NavigationViewItem Tag="Document"
                                    ToolTipService.Placement="Right">
                    <ToolTipService.ToolTip>
                        <ToolTip HorizontalOffset="12">
                            <TextBlock Text="{x:Bind models:Lang.HomeSettingDialog_Document}"/>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE736;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Border Height="40">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind models:Lang.HomeSettingDialog_Document}"/>
                        </Border>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="0,48,0,0"/>

        </NavigationView>

    </Grid>
</fw:WindowEx>
