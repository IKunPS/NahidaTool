<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- 兼容旧版 Windows 10 的 CET 启动问题，仅对本程序关闭兼容标记。 -->
    <CETCompat>false</CETCompat>
    <RootNamespace>NahidaTool</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationIcon>Assets\ic_launcher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SignAssembly>False</SignAssembly>
    <Version>0.1.8.0</Version>
    <AssemblyVersion>0.1.8.0</AssemblyVersion>
    <FileVersion>0.1.8.0</FileVersion>
    <InformationalVersion>0.1.8</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.34.1" />
    <PackageReference Include="Polly.Core" Version="8.6.6" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.7" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
    <PackageReference Include="Vanara.PInvoke.ComCtl32" Version="5.0.4" />
    <PackageReference Include="Vanara.PInvoke.DwmApi" Version="5.0.4" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="5.0.4" />
    <PackageReference Include="Zstandard.Net" Version="1.1.7" />
    <PackageReference Include="SharpHDiffPatch.Core" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\ServerSwitchCache\" />
    <Folder Include="Assets\Tutorials\" />
  </ItemGroup>

  <!-- Release 输出到 bin/App -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\app\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- 自包含发布保留页面、背景与内置素材，排除运行时生成的转服缓存。 -->
  <Target Name="IncludeWinUiResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_NahidaWinUiPublishResource Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
      <_NahidaAssetPublishResource Include="$(TargetDir)Assets\**\*"
                                  Exclude="$(TargetDir)Assets\ServerSwitchCache\**\*" />
      <ResolvedFileToPublish Include="@(_NahidaWinUiPublishResource)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_NahidaAssetPublishResource)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>Assets\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
           Text="WinUI resource index is missing. Build the application before publishing." />
  </Target>

</Project>
