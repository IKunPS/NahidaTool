<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- 恢复原有 0.35 黑色毛玻璃，只调整背景，不降低文字与按钮透明度。 -->
            <AcrylicBrush x:Key="DialogBackgroundBrush" TintColor="Black"
                          TintOpacity="0.35" FallbackColor="#F52C2C2C"/>
            <SolidColorBrush x:Key="DialogCardBackgroundBrush" Color="#0AFFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <AcrylicBrush x:Key="DialogBackgroundBrush" TintColor="White"
                          TintOpacity="0.35" FallbackColor="#F5F3F3F3"/>
            <SolidColorBrush x:Key="DialogCardBackgroundBrush" Color="#38FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DialogBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="DialogCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 只统一外观，保留原生弹窗的焦点、键盘与关闭行为。 -->
    <Style x:Key="NahidaDialogStyle" TargetType="ContentDialog"
           BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Background" Value="{ThemeResource DialogBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style x:Key="DialogBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="23"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsTextSelectionEnabled" Value="True"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="DialogSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="DialogItemTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DialogCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <Style x:Key="DialogScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalScrollMode" Value="Disabled"/>
        <Setter Property="ZoomMode" Value="Disabled"/>
        <Setter Property="Padding" Value="0,0,8,0"/>
    </Style>
</ResourceDictionary>
